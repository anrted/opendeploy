[Unit]
Description=Update OpenDeploy from its trusted GitHub repository
Documentation=https://github.com/anrted/opendeploy
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/lib/opendeploy/update.sh
TimeoutStartSec=20min
PrivateTmp=yes
